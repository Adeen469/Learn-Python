GEMINI_API_KEY=your-gemini-api-key
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_DRIVE_API_KEY=your-google-drive-api-key
GROQ_API_KEY=your-groq-api-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SESSION_SECRET=replace-with-a-random-32-byte-secret

# Server-only Supabase service access; never add a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional AI providers.
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key
OPENROUTER_API_KEY=your-openrouter-api-key

# Optional encryption keys; use unique random values in production.
GITHUB_TOKEN_KEY=replace-with-a-random-32-byte-key
TOTP_ENCRYPTION_KEY=replace-with-a-random-32-byte-key
BYOK_ENCRYPTION_KEY=replace-with-a-random-32-byte-key

# Optional email delivery.
GMAIL_USER=your-gmail-address
GMAIL_APP_PASSWORD=your-gmail-app-password

# Optional distributed rate limiting.
UPSTASH_REDIS_REST_URL=https://your-upstash-rest-url
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# Set only when the app is behind a trusted reverse proxy.
APP_URL=http://localhost:3000
TRUST_PROXY_HEADERS=
TRUSTED_PROXY_HOPS=
