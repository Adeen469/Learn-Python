# Supabase (Public Client Keys - Safe for browser/APK with RLS enabled)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-Side Only (Place your actual secrets inside a local .env.local file - NEVER commit .env.local)
GOOGLE_DRIVE_API_KEY=your_restricted_google_drive_api_key
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here
